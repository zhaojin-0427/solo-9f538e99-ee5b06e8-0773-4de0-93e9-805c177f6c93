  <acct:Receivables contextRef="ctx1" unitRef="usd" decimals="0">60</acct:Receivables>
  <acct:CurrentAssets contextRef="ctx1" unitRef="usd" decimals="0">200</acct:CurrentAssets>
  <acct:NonCurrentAssets contextRef="ctx1" unitRef="usd" decimals="0">300</acct:NonCurrentAssets>
  <acct:Assets contextRef="ctx1" unitRef="usd" decimals="0">500</acct:Assets>
  <acct:Revenues contextRef="ctx1" unitRef="usd" decimals="0">800</acct:Revenues>
  <acct:Expenses contextRef="ctx1" unitRef="usd" decimals="0">500</acct:Expenses>
</xbrli:xbrl>
